APP_ENV=production
APP_VERSION=1.1.0
SECRET_KEY=replace-with-a-long-random-secret
API_KEY=replace-with-a-long-random-api-key
DATABASE_URL=sqlite:////absolute/path/to/flask-lab/instance/prod.db
LOG_LEVEL=INFO
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_PIDFILE=/tmp/gunicorn.pid
